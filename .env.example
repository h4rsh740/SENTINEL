# SENTINEL Environment Configuration
# Copy this file to .env and customize as needed.

# Server Configuration
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
SENTINEL_ENV=development

# Storage Configuration
SENTINEL_DB_PATH=sentinel_audit.db
SENTINEL_POLICY_DIR=policies

# BharatCode API Integration (Advisory Policy Assistance)
# Official Base URL: https://bharatcode.ai/api/model/v1
# Default Model: qwen-3.8-27b
# NOTE: The policy engine operates 100% offline and deterministic if this key is unset.
BHARATCODE_API_BASE=https://bharatcode.ai/api/model/v1
BHARATCODE_API_KEY=
BHARATCODE_MODEL=qwen-3.8-27b

# Web Console Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
